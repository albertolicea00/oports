Screen { background: #101820; color: #e5edf3; }
TabbedContent { height: 1fr; }
.split { height: 1fr; }
#lan-table, #local-table { width: 55%; }
#inspector-pane, #local-detail { width: 45%; height: 1fr; border-left: solid #417d93; }
#inspector { height: 1fr; padding: 1 2; overflow-y: auto; }
#scan-progress { height: 3; padding: 0 2; }
#local-detail { padding: 1 2; overflow-y: auto; }
#subnet { height: 3; padding: 1 2; color: #82d8dc; }
#filter { height: 3; }
#traffic-table { height: 1fr; }
#wan-info { padding: 2 3; }
ConfirmKill { align: center middle; background: #0009; }
#confirm { width: 58; height: 8; padding: 1 2; border: heavy #e3a15a; background: #263743; }
#confirm Horizontal { height: 3; align-horizontal: right; }
#confirm Button { margin-left: 1; }
